# ─── Anthropic ────────────────────────────────────────────────────────────────
# Required. Used for chat responses and query reformulation.
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Voyage AI ────────────────────────────────────────────────────────────────
# Required. Used for generating embeddings (voyage-3-lite) and reranking (rerank-2).
# Get it at: https://dashboard.voyageai.com/api-keys
VOYAGE_API_KEY=pa-...

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Required. Connection string to your Atlas cluster.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Get it at: https://cloud.mongodb.com → your cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://...

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Optional. Without a token, GitHub API allows only 60 requests/hour.
# With a token (no scopes needed for public repos): 5000 requests/hour.
# Get it at: https://github.com/settings/tokens → Generate new token (classic)
GITHUB_TOKEN=ghp_...
